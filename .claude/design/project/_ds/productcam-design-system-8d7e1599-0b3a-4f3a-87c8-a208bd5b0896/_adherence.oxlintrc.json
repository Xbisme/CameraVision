{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/batch/**",
              "components/camera/**",
              "components/core/**",
              "components/editor/**",
              "components/feedback/**",
              "ui_kits/productcam-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackgroundOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|type|value|key|ref|className|style|children)$/]",
        "message": "<BackgroundOption> doesn't accept that prop. Declared props: id, label, type, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackgroundOption'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:checker|color|gradient|custom)$/]",
        "message": "<BackgroundOption> type must be one of 'checker' | 'color' | 'gradient' | 'custom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|caution|danger|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'caution' | 'danger' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchThumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|status|progress|src|shape|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BatchThumb> doesn't accept that prop. Declared props: index, status, progress, src, shape, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchThumb'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:queued|working|done|review|error)$/]",
        "message": "<BatchThumb> status must be one of 'queued' | 'working' | 'done' | 'review' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchThumb'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:box|bottle|bag|shoe)$/]",
        "message": "<BatchThumb> shape must be one of 'box' | 'bottle' | 'bag' | 'shoe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|loading|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, fullWidth, loading, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|glass|caution|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'glass' | 'caution' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckerSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|radius|pad|style|key|ref|className|style|children)$/]",
        "message": "<CheckerSurface> doesn't accept that prop. Declared props: children, tone, radius, pad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckerSurface'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<CheckerSurface> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|selected|size|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, icon, selected, size, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Chip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|caution)$/]",
        "message": "<Chip> tone must be one of 'default' | 'caution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContourOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|shape|path|bbox|ticks|sweep|stretch|style|key|ref|className|style|children)$/]",
        "message": "<ContourOverlay> doesn't accept that prop. Declared props: state, shape, path, bbox, ticks, sweep, stretch, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContourOverlay'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:scanning|locked|review)$/]",
        "message": "<ContourOverlay> state must be one of 'scanning' | 'locked' | 'review'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContourOverlay'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:box|bottle|bag|shoe)$/]",
        "message": "<ContourOverlay> shape must be one of 'box' | 'bottle' | 'bag' | 'shoe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EdgeNotice'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actionLabel|onAction|dismissLabel|onDismiss|icon|style|key|ref|className|style|children)$/]",
        "message": "<EdgeNotice> doesn't accept that prop. Declared props: title, children, actionLabel, onAction, dismissLabel, onDismiss, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|active|badge|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, active, badge, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glass|solid|ghost|accent)$/]",
        "message": "<IconButton> variant must be one of 'glass' | 'solid' | 'ghost' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeToggleOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<ModeToggleOption> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressTrace'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|thickness|tone|label|indeterminate|style|key|ref|className|style|children)$/]",
        "message": "<ProgressTrace> doesn't accept that prop. Declared props: value, size, thickness, tone, label, indeterminate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressTrace'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|caution|danger)$/]",
        "message": "<ProgressTrace> tone must be one of 'accent' | 'caution' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Readout'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|children|meta|icon|style|key|ref|className|style|children)$/]",
        "message": "<Readout> doesn't accept that prop. Declared props: state, children, meta, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Readout'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|scanning|locked|review|error)$/]",
        "message": "<Readout> state must be one of 'idle' | 'scanning' | 'locked' | 'review' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|footer|onClose|handle|tone|style|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: title, subtitle, children, footer, onClose, handle, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<Sheet> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShutterButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|count|onCapture|onLongPress|label|style|key|ref|className|style|children)$/]",
        "message": "<ShutterButton> doesn't accept that prop. Declared props: state, count, onCapture, onLongPress, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShutterButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ready|locked|busy|disabled)$/]",
        "message": "<ShutterButton> state must be one of 'ready' | 'locked' | 'busy' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, unit, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, tone, icon, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|caution|danger)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'accent' | 'caution' | 'danger'."
      }
    ]
